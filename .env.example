# Fonnte
FONNTE_TOKEN=
FONNTE_SEND_URL=https://api.fonnte.com/send

# Matching
MATCH_THRESHOLD=65
FALLBACK_STREAK_FOR_HANDOVER=3

# Google Sheets (FAQ store) - kosongkan buat pakai data/faq_seed.json lokal
GOOGLE_SHEET_ID=
GOOGLE_SHEET_WORKSHEET=faq
# Dev lokal: path ke file JSON service account (jangan commit, sudah di .gitignore)
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
# Deploy (fly secrets set): isi JSON service account langsung sebagai string,
# dipakai kalau GOOGLE_SERVICE_ACCOUNT_JSON diisi (menang atas GOOGLE_SERVICE_ACCOUNT_FILE)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Storage
DB_PATH=data/conversation_log.db
FAQ_SEED_PATH=data/faq_seed.json
