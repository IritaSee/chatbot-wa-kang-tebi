# Fonnte
FONNTE_TOKEN=
FONNTE_SEND_URL=https://api.fonnte.com/send

# Matching
MATCH_THRESHOLD=65
FALLBACK_STREAK_FOR_HANDOVER=3

# Google Sheets (FAQ + contacts + log store) - WAJIB diisi, gak ada fallback lokal
# untuk contacts/log/handover. FAQ doang yang fallback ke data/faq_seed.json kalau kosong.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_WORKSHEET=faq
GOOGLE_SHEET_CONTACTS_WORKSHEET=contacts
GOOGLE_SHEET_LOG_WORKSHEET=log
# Dev lokal: path ke file JSON service account (jangan commit, sudah di .gitignore)
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
# Deploy (Vercel env var): isi JSON service account langsung sebagai string,
# dipakai kalau GOOGLE_SERVICE_ACCOUNT_JSON diisi (menang atas GOOGLE_SERVICE_ACCOUNT_FILE)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Storage
FAQ_SEED_PATH=data/faq_seed.json

# Tier 2: LLM (dipilih user lewat menu "8. Lainnya"). Default OpenRouter (satu
# API key, banyak model termasuk Claude, format request OpenAI-compatible).
# Kosongin LLM_API_KEY buat matiin tier 2 total (langsung eskalasi ke admin
# begitu user pilih menu 8). Ganti LLM_BASE_URL/LLM_MODEL buat provider lain
# yang OpenAI-compatible juga (nol perubahan kode).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=anthropic/claude-3.5-haiku
LLM_MAX_TOKENS=500
# Cap jumlah panggilan LLM per nomor per hari; lewat cap -> auto-eskalasi ke admin
LLM_DAILY_CAP=10
# Idle sekian menit di mode LLM -> otomatis balik ke fuzzy
LLM_MODE_IDLE_MINUTES=30
